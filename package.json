{
  "name": "elektroplan",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Elektroplan CAE Suite - EPLAN Electric P8 compatible CAD software for electrical schematics (Windows Desktop)",
  "author": "VitalS5",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "test": "tsx src/model/AutoconnectEngine.test.ts && tsx src/model/LabelLayout.test.ts",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/jspdf": "^1.3.3",
    "@types/node": "^22.13.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "de.elektroplan.cae",
    "productName": "Elektroplan Suite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
